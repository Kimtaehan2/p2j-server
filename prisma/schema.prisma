// P2J 서버 Prisma 스키마
//
// 이번 scaffold 단계에서는 datasource 와 Client 생성까지만 구성한다.
// 전체 모델(ERD v1 의 15개 테이블)과 최초 migration 은 다음 작업에서
// 김태한·박영준 공동 리뷰를 거쳐 추가한다.
// 자세한 정책은 docs/database/migration-policy.md 를 따른다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 부터 접속 URL 은 schema 가 아니라 prisma.config.ts(Migrate)와
// PrismaClient 의 driver adapter(런타임)에서 지정한다.
datasource db {
  provider = "postgresql"
}
