# P2J 서버 환경변수 예시
# 이 파일만 커밋한다. 실제 값이 담긴 .env 는 절대 커밋하지 않는다.
# 실키는 팀 Notion 비공개 페이지 또는 Discord DM 으로 공유한다.
#
# 사용법: cp .env.example .env  (Windows: copy .env.example .env)

# --- 서버 ---
NODE_ENV=development
PORT=8000

# --- DB ---
DATABASE_URL=postgresql://postgres:devpass@localhost:5432/p2j?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT (auth 모듈 구현 시 필수) ---
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=3600
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=2592000

# --- 도메인 규칙 ---
# 하루 경계 시각. 04 = 매일 04:00 KST 에 날짜가 넘어간다.
SERVICE_DAY_START_HOUR=4
# 비워 두면 선언 마감 없음 (2주차 미결 사항)
DECLARATION_CUTOFF_HOUR=

# --- Firebase Storage (uploads 모듈 구현 시 필수) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# 개행 문자는 이스케이프한 형태로 한 줄에 넣는다.
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# --- 외부 API (ai 모듈 구현 시 필수) ---
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- 제한 ---
AI_PARSE_DAILY_LIMIT=30
PROOF_IMAGE_MAX_BYTES=5242880

# --- CORS ---
# 운영 환경에서 허용할 origin 을 콤마로 구분해 나열한다.
# 비워 두면 운영 환경에서는 CORS 를 열지 않는다. 개발 환경에서는 항상 허용한다.
CORS_ORIGINS=
